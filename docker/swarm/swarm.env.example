# Swarm stack environment (non-secret values only).
# Copy to docker/swarm/swarm.env (git-ignored) and adjust. The file is sourced by
# the shell, so keep values shell-safe (quote anything with spaces).
# Secrets (APP_KEY, DB/Redis passwords, Meilisearch key) are NOT set here: they are
# Docker secrets created with `make swarm-secrets`.

# Image tag for vitalease/app and vitalease/nginx (default: current git short sha).
# IMAGE_TAG=

# Port published by nginx on the host (HTTP only).
HTTP_PORT=80

APP_NAME="VitalEase"
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=es
# Public URL clients use to reach the server (LAN address of the Swarm node).
APP_URL=http://192.168.1.10
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Only nginx's overlay subnet is trusted as proxy (must match the network ipam).
TRUSTED_PROXIES=10.20.0.0/24

# HTTP only: secure cookies would never be sent back over plain HTTP.
SESSION_SECURE_COOKIE=false
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vitalease
DB_USERNAME=vitalease
DB_CONNECT_TIMEOUT=5

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT=2
REDIS_READ_TIMEOUT=5

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
SCOUT_JOB_TRIES=15
MEILISEARCH_HOST=http://meilisearch:7700
# Web timeouts (connect/total seconds); worker, scheduler and jobs use 2/15.
MEILISEARCH_CONNECT_TIMEOUT=1
MEILISEARCH_TIMEOUT=3
